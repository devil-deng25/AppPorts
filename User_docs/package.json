{
  "name": "appports-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docs:prepare": "node scripts/prepare-fumadocs.mjs",
    "docs:dev": "npm run docs:prepare && next dev --hostname 127.0.0.1 --port 4173",
    "docs:build": "npm run docs:prepare && next build && node scripts/export-legacy-paths.mjs",
    "docs:preview": "serve out --listen tcp://127.0.0.1:4173",
    "docs:typecheck": "next typegen && tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.3",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.3",
    "lucide-react": "^1.50.0",
    "mermaid": "^11.15.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.28",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
